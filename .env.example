# Frontend Environment Variables
# Copy this file to .env.production and update with your values

# Backend API URL - Update this to your deployed backend URL
VITE_API_URL=https://your-backend-url.com

# Examples:
# VITE_API_URL=https://your-portfolio-api.onrender.com
# VITE_API_URL=https://your-portfolio-api.railway.app
# VITE_API_URL=https://your-portfolio-api.herokuapp.com
